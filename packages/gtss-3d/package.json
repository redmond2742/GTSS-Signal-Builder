{
    "name": "gtss-3d",
    "version": "1.0.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "esbuild index.ts --bundle --format=esm --platform=browser --packages=external --jsx=automatic --outdir=dist && tsc -p tsconfig.json",
        "test": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "three": "^0.170.0"
    },
    "peerDependencies": {
        "gtss": "*",
        "react": "^18.3.1"
    },
    "devDependencies": {
        "@types/three": "^0.170.0",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    }
}