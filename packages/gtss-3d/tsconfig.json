{
    "extends": "../../tsconfig.json",
    "include": [
        "./index.ts",
        "./src/**/*.ts",
        "./src/**/*.tsx"
    ],
    "exclude": [
        "./dist",
        "./node_modules",
        "./test"
    ],
    "compilerOptions": {
        "incremental": false,
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": true,
        "jsx": "react-jsx",
        "outDir": "./dist",
        "rootDir": "."
    }
}