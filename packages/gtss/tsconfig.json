{
    "extends": "../../tsconfig.json",
    "include": [
        "./**/*.ts",
        "./**/*.tsx"
    ],
    "exclude": [
        "./dist",
        "./node_modules"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "incremental": false,
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "rootDir": ".",
        "paths": {
            "packages/gtss": [
                "./index.ts"
            ],
            "packages/gtss/*": [
                "./*"
            ]
        }
    }
}